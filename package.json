{
  "name": "@my-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve:admin": "nx run admin-panel-api:serve",
    "serve:website": "nx run website-api:serve",
    "serve:mobile": "nx run mobile-api:serve",
    "build:admin": "nx run admin-panel-api:build",
    "build:website": "nx run website-api:build",
    "build:mobile": "nx run mobile-api:build",
    "serve:all": "nx run-many --target=serve --projects=admin-panel-api,website-api,mobile-api --parallel",
    "typeorm": "ts-node --project tsconfig.base.json --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true}\" -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d libs/shared/database/src/typeorm/data-source.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:generate": "npm run typeorm migration:generate",
    "typeorm-ext": "ts-node --project tsconfig.base.json --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true}\" -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.cjs -d libs/shared/database/src/typeorm/data-source.ts",
    "seed:run": "npm run typeorm-ext seed:run",
    "seed:revert": "npm run typeorm-ext seed:revert",
    "seed:generate": "npm run typeorm-ext seed:create"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.7.3",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.2.3",
    "@nx/eslint-plugin": "22.2.3",
    "@nx/jest": "22.2.3",
    "@nx/js": "^22.2.3",
    "@nx/nest": "^22.2.3",
    "@nx/node": "^22.2.3",
    "@nx/web": "22.2.3",
    "@nx/webpack": "22.2.3",
    "@nx/workspace": "22.2.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nodemon": "^3.1.11",
    "nx": "^22.2.3",
    "prettier": "^2.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
