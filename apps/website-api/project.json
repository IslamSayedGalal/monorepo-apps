{
  "name": "website-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website-api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/website-api",
        "command": "tsc -p tsconfig.app.json"
      },
      "outputs": ["{workspaceRoot}/dist/apps/website-api"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/website-api",
        "command": "ts-node --project tsconfig.app.json -r tsconfig-paths/register src/main.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "options": {
        "lintFilePatterns": ["apps/website-api/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/website-api/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
